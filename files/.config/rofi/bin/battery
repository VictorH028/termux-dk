#!/data/data/com.termux/files/usr/bin/bash

theme="$HOME/.config/rofi/default/network.rasi"
info="$(timeout 3 termux-battery-status 2>/dev/null)"

if [ -z "$info" ]; then
	rofi -e "termux-api is not available" -theme "$theme"
	exit 1
fi

percentage="$(printf '%s' "$info" | jq -r '.percentage')"
status="$(printf '%s' "$info" | jq -r '.status')"
temperature="$(printf '%s' "$info" | jq -r '.temperature')"

printf 'Battery: %s%%\nStatus: %s\nTemperature: %s C\n' \
	"$percentage" "$status" "$temperature" |
	rofi -dmenu -p "Battery" -theme "$theme"
