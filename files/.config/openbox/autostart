#!/data/data/com.termux/files/usr/bin/bash

if command -v xrandr >/dev/null 2>&1; then
	xrandr --dpi 160 >/dev/null 2>&1
fi

if command -v xrdb >/dev/null 2>&1; then
	echo "Xft.dpi: 160" | xrdb -merge
fi

[ -x "$HOME/.fehbg" ] && "$HOME/.fehbg" &

command -v pulseaudio >/dev/null 2>&1 && pulseaudio --start --exit-idle-time=-1 >/dev/null 2>&1
command -v xfsettingsd >/dev/null 2>&1 && xfsettingsd &

# ~/.local/bin/ob-compositor --start &

sleep 1

[ -x "$HOME/.config/polybar/launch.sh" ] && "$HOME/.config/polybar/launch.sh" &

command -v thunar >/dev/null 2>&1 && thunar --daemon &
command -v xfce4-terminal >/dev/null 2>&1 && xfce4-terminal &
